# Copy to .env and fill in. .env is gitignored. Never put secrets in VITE_* variables.

# --- Backend (server-side only) ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
CACHE_TIMEOUT_S=900
# Forecast cache size (one entry per ~5 km grid cell and hour window)
CACHE_MAX_ENTRIES=10000

# Provider adapters are selected by name
ROUTING_PROVIDER=here
GEOCODING_PROVIDER=here
# here: HERE Destination Weather (production, uses HERE_API_KEY); open-meteo: keyless alternative.
# Open-Meteo's free tier counts requests per IP and is exhausted on shared hosting IPs such as Render's.
WEATHER_PROVIDER=here

# HERE (https://platform.here.com): Routing v8 + Geocoding & Search v7
HERE_API_KEY=
HERE_ROUTING_BASE_URL=https://router.hereapi.com/v8
HERE_GEOCODING_BASE_URL=https://geocode.search.hereapi.com/v1
HERE_WEATHER_BASE_URL=https://weather.hereapi.com/v3
# Parallel HERE weather requests (one location each; each worker thread has its own HTTP session)
HERE_WEATHER_CONCURRENCY=12
# Overall limit for one batch of weather lookups; unfinished locations become Unknown
HERE_WEATHER_DEADLINE_S=60
# Alternatives requested in addition to the primary route (HERE allows 0-6; 2 => up to 3 routes)
ROUTE_ALTERNATIVES=2
# ISO 3166-1 alpha-3 codes to restrict geocoding (comma-separated); empty = worldwide
GEOCODE_COUNTRY_CODES=USA

# Empty tractor-trailer weight. Routing weight sent to HERE = this + cargo load (kg).
# Weather risk load rules use the cargo load only.
TRUCK_EMPTY_WEIGHT_LB=35000

# Open-Meteo: keyless for non-commercial use; commercial use needs a key and the customer- URL
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=
# Heatmap grid cap (each cell = one forecast location)
# Defaults: 80 with WEATHER_PROVIDER=here (one request per cell), 200 with open-meteo
# HEATMAP_MAX_CELLS=80

# Outbound HTTP behaviour
PROVIDER_CONNECT_TIMEOUT_S=3
PROVIDER_READ_TIMEOUT_S=10
PROVIDER_MAX_RETRIES=2

# Per-client rate limits (the endpoints are public and spend provider quota)
THROTTLE_EVALUATE=30/hour
THROTTLE_HEATMAP=60/hour
# Proxies in front of the app, for client IPs from X-Forwarded-For (e.g. 1 on Render); unset = whole header
# NUM_PROXIES=1
# Max seconds for one provider call including retries
PROVIDER_CALL_BUDGET_S=20

# --- Frontend (Vite exposes VITE_* to the browser: public values only) ---
# Empty in development: the Vite dev server proxies /api to Django on :8000.
# Production: the deployed backend origin, e.g. https://api.example.com
VITE_API_BASE_URL=
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
